# Re-check of pairs whose latest top-of-book cost is near parity — a small set,
# ~30 seconds, catching intraday dislocations between full sweeps.

[Unit]
Description=karb — hot-tier re-check (every 15 min)

[Timer]
# :07, :22, :37, :52 — off the top of the hour, where the two-hourly sweep
# runs, and off 07:35, where the sports fetch starts. Both write this database.
OnCalendar=*-*-* *:07/15:00 UTC

# No Persistent=. This job is about prices right now; running a missed one at
# boot would burn API calls to answer a question that has expired.
Persistent=false

# Keeps 96 identical requests a day off the same second of the clock.
RandomizedDelaySec=90

[Install]
WantedBy=timers.target
